SELECT name, line, text FROM dba_source
WHERE owner = 'ANALYTICS' AND name = 'ETL_EMAIL_PKG'
AND UPPER(text) LIKE '%NO JOB RUNS FOUND%';


SELECT job_name, status, actual_start_date, run_duration
FROM dba_scheduler_job_run_details
WHERE job_name = 'DAILY_ETL'
ORDER BY log_date DESC;


SELECT * FROM <log_table>
WHERE <date_col> >= TRUNC(SYSDATE) - 1
ORDER BY <date_col> DESC;


SELECT line, text FROM dba_source
WHERE owner = 'ANALYTICS'
AND name = 'ETL_EMAIL_PKG'
AND type = 'PACKAGE BODY'
AND line BETWEEN 200 AND 295
ORDER BY line;

FROM  ALL_SCHEDULER_JOB_RUN_DETAILS
WHERE owner IN ('SRC_VALERIR', 'SRC_WEBLGY')
AND   TRUNC(actual_start_date) = TRUNC(SYSDATE - 10)

-- What runs actually exist for those owners?
SELECT owner, job_name, status, actual_start_date
FROM dba_scheduler_job_run_details
WHERE owner IN ('SRC_VALERIR','SRC_WEBLGY')
AND actual_start_date >= SYSDATE - 35
ORDER BY actual_start_date DESC;

-- When is the monthly email normally scheduled?
SELECT repeat_interval, next_run_date
FROM dba_scheduler_jobs
WHERE job_name = 'MONTHLY_ETL_EMAIL_JOB';


