-- 3. GENERATE THE FIX STATEMENTS
--    Each query below OUTPUTS SQL. Copy the output and run it.
-- ============================================================

-- 3a. Transfer tables/views to awsuser
SELECT 'ALTER TABLE ' || quote_ident(TRIM(n.nspname)) || '.' || quote_ident(TRIM(c.relname))
       || ' OWNER TO awsuser;'
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
  AND c.relkind IN ('r','v');

-- 3b. Transfer functions AND stored procedures (picks the right keyword automatically)
SELECT 'ALTER ' || CASE WHEN p.prokind = 'p' THEN 'PROCEDURE ' ELSE 'FUNCTION ' END
       || quote_ident(TRIM(n.nspname)) || '.' || quote_ident(TRIM(p.proname))
       || '(' || oidvectortypes(p.proargtypes) || ') OWNER TO awsuser;'
FROM pg_proc_info p
JOIN pg_namespace n ON n.oid = p.pronamespace
WHERE p.proowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3c. Transfer schemas
SELECT 'ALTER SCHEMA ' || quote_ident(TRIM(nspname)) || ' OWNER TO awsuser;'
FROM pg_namespace
WHERE nspowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3d. Revoke schema privileges
SELECT DISTINCT 'REVOKE ALL ON SCHEMA ' || quote_ident(namespace_name)
       || ' FROM ' || quote_ident(identity_name) || ';'
FROM svv_schema_privileges
WHERE identity_type = 'user'
  AND identity_id IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3e. Revoke table/view privileges
SELECT DISTINCT 'REVOKE ALL ON ' || quote_ident(namespace_name) || '.' || quote_ident(relation_name)
       || ' FROM ' || quote_ident(identity_name) || ';'
FROM svv_relation_privileges
WHERE identity_type = 'user'
  AND identity_id IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3f. Revoke function privileges
SELECT DISTINCT 'REVOKE ALL ON FUNCTION ' || quote_ident(namespace_name) || '.' || quote_ident(function_name)
       || '(' || NVL(argument_types, '') || ') FROM ' || quote_ident(identity_name) || ';'
FROM svv_function_privileges
WHERE identity_type = 'user'
  AND identity_id IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3g. Revoke database privileges
SELECT DISTINCT 'REVOKE ALL ON DATABASE ' || quote_ident(database_name)
       || ' FROM ' || quote_ident(identity_name) || ';'
FROM svv_database_privileges
WHERE identity_type = 'user'
  AND identity_id IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);

-- 3h. Revoke default privileges (owned BY these users, or granted TO them)
SELECT DISTINCT 'ALTER DEFAULT PRIVILEGES FOR USER ' || quote_ident(owner_name)
       || CASE WHEN schema_name IS NOT NULL THEN ' IN SCHEMA ' || quote_ident(schema_name) ELSE '' END
       || ' REVOKE ALL ON '
       || CASE object_type WHEN 'RELATION'  THEN 'TABLES'
                           WHEN 'FUNCTION'  THEN 'FUNCTIONS'
                           WHEN 'PROCEDURE' THEN 'PROCEDURES' END
       || ' FROM '
       || CASE grantee_type WHEN 'group' THEN 'GROUP ' WHEN 'role' THEN 'ROLE ' ELSE '' END
       || quote_ident(grantee_name) || ';'
FROM svv_default_privileges
WHERE owner_id   IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
   OR grantee_id IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186);


