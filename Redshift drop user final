SELECT u.usename, 'table/view' AS kind, TRIM(n.nspname) || '.' || TRIM(c.relname) AS name
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
JOIN pg_user u ON u.usesysid = c.relowner
WHERE c.relowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
  AND c.relkind IN ('r','v')
UNION ALL
SELECT u.usename, 'function/procedure', TRIM(n.nspname) || '.' || TRIM(p.proname)
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
JOIN pg_user u ON u.usesysid = p.proowner
WHERE p.proowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
UNION ALL
SELECT u.usename, 'schema', TRIM(n.nspname)
FROM pg_namespace n
JOIN pg_user u ON u.usesysid = n.nspowner
WHERE n.nspowner IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
UNION ALL
SELECT u.usename, 'database', TRIM(d.datname)
FROM pg_database d
JOIN pg_user u ON u.usesysid = d.datdba
WHERE d.datdba IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
UNION ALL
SELECT u.usename, 'default acl', CAST(a.defaclnamespace AS VARCHAR)
FROM pg_default_acl a
JOIN pg_user u ON u.usesysid = a.defacluser
WHERE a.defacluser IN (194,102,155,178,118,107,115,111,135,134,148,147,141,108,142,180,186)
