SELECT text
FROM dba_source
WHERE owner = 'ANALYTICS'
  AND name = 'LOAN_BORROWER_ETL_PKG'
  AND type = 'PACKAGE BODY'
ORDER BY line;


-- ============================================================
-- Step 7: Investigate the oddly-named package — check if it's a
-- one-off patch (ticket number suffix) that may have replaced or
-- broken the original load chain
-- ============================================================
SELECT text
FROM dba_source
WHERE owner = 'ANALYTICS'
  AND name = 'LOAD_LOAN_HISTORY_PKG_LGYA1317599'
  AND type = 'PACKAGE BODY'
ORDER BY line;

-- Check when this package was created/last modified vs. the
-- original — a recent compile date near July could explain the cutoff
SELECT object_name, object_type, created, last_ddl_time, status
FROM dba_objects
WHERE object_name IN ('LOAN_BORROWER_ETL_PKG', 'LOAD_LOAN_HISTORY_PKG_LGYA1317599', 'ETL_API_PKG')
ORDER BY last_ddl_time DESC;



