2-- ============================================================
-- Investigating stale LOAN_BORROWER_DTL table (Oracle DB)
-- ============================================================

-- STEP 1: Confirm the table exists and find its actual owner/schema
-- (Run this FIRST — the result tells you what schema to plug into
-- the dependency query below)
SELECT owner, table_name 
FROM dba_tables 
WHERE table_name = 'LOAN_BORROWER_DTL';

-- If nothing comes back, try a broader search in case of naming variants
SELECT owner, table_name 
FROM dba_tables 
WHERE table_name LIKE '%LOAN_BORROWER%';


-- STEP 2: Find scheduled jobs that might load this table
-- (modern Oracle Scheduler)
SELECT job_name, enabled, state, last_start_date, last_run_duration, next_run_date
FROM dba_scheduler_jobs
WHERE LOWER(job_name) LIKE '%loan%' OR LOWER(job_name) LIKE '%borrower%';

-- Check job run history / failures for those jobs
SELECT job_name, status, error#, actual_start_date, run_duration, additional_info
FROM dba_scheduler_job_run_details
WHERE LOWER(job_name) LIKE '%loan%' OR LOWER(job_name) LIKE '%borrower%'
ORDER BY actual_start_date DESC;

-- If this Oracle instance uses the OLDER legacy job scheduler instead
SELECT job, what, last_date, next_date, broken
FROM dba_jobs
WHERE LOWER(what) LIKE '%loan%' OR LOWER(what) LIKE '%borrower%';


-- STEP 3: Find procedures/views/packages that reference the table
-- (add "AND owner = 'YOUR_SCHEMA'" once you know it from Step 1)
SELECT owner, name, type
FROM dba_dependencies
WHERE referenced_name = 'LOAN_BORROWER_DTL'
ORDER BY owner, name;



-- ============================================================
-- Step 4: Find the job(s) that actually call LOAN_BORROWER_ETL_PKG
-- (search job_action text instead of job name — the job name
-- might not match "loan"/"borrower" at all)
-- ============================================================
SELECT job_name, enabled, state, last_start_date, last_run_duration, 
       next_run_date, job_action
FROM dba_scheduler_jobs
WHERE UPPER(job_action) LIKE '%LOAN_BORROWER_ETL_PKG%'
   OR UPPER(job_action) LIKE '%ETL_API_PKG%';

-- Check its run history / errors specifically
SELECT job_name, status, error#, actual_start_date, run_duration, additional_info
FROM dba_scheduler_job_run_details
WHERE UPPER(job_name) IN (
    SELECT job_name FROM dba_scheduler_jobs
    WHERE UPPER(job_action) LIKE '%LOAN_BORROWER_ETL_PKG%'
)
ORDER BY actual_start_date DESC;


-- ============================================================
-- Step 5: Check what LOAN_RECIDIVISM_ETL actually does before
-- ruling it out — confirm whether it's unrelated or a real dependency
-- ============================================================
SELECT job_name, job_action, job_type, comments
FROM dba_scheduler_jobs
WHERE job_name = 'LOAN_RECIDIVISM_ETL';


-- ============================================================
-- Step 6: Pull the source of LOAN_BORROWER_ETL_PKG to see the load
-- logic and confirm what it references (e.g. does it call the
-- suspicious LOAD_LOAN_HISTORY_PKG_LGYA1317599 variant?)
