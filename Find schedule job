-- ============================================================
-- Step 10: Check if DAILY_ETL is genuinely stuck right now
-- (compare start time to current time — long-running/hung job?)
-- ============================================================
SELECT job_name, state, last_start_date, 
       SYSDATE AS current_time,
       (SYSDATE - CAST(last_start_date AS DATE)) * 24 * 60 AS minutes_running
FROM dba_scheduler_jobs
WHERE job_name = 'DAILY_ETL';

-- Check currently running job details/session info (if it's hung)
SELECT r.job_name, r.session_id, r.running_instance, r.elapsed_time, r.cpu_used
FROM dba_scheduler_running_jobs r
WHERE r.job_name = 'DAILY_ETL';


-- ============================================================
-- Step 11: Check the ETL log table for actual success/failure 
-- records tied to LOAN_BORROWER_DTL loads (this package clearly
-- writes to ETL.ETL_LOG based on the source)
-- ============================================================
SELECT *
FROM ETL.ETL_LOG
WHERE UPPER(subject_area) LIKE '%LOAN_BORROWER%'
   OR UPPER(source_system) LIKE '%LOAN%'
ORDER BY load_date DESC  -- adjust column name once you see actual structure
FETCH FIRST 20 ROWS ONLY;
