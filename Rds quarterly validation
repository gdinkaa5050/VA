-- ============================================================
-- Oracle RDS Quarterly DBA Validation — All Queries
-- ============================================================

-- Row 3: Inventory & Baseline
SELECT name, open_mode, log_mode, created FROM v$database;
SELECT banner_full FROM v$version;
SELECT name, value FROM v$parameter WHERE isdefault='FALSE' ORDER BY name;

-- Row 4: Engine & Patching
SELECT action_time, action, patch_id, description
FROM dba_registry_sqlpatch
ORDER BY action_time DESC;

-- Row 5: Encryption
SELECT tablespace_name, encrypted FROM dba_tablespaces;

SELECT network_service_banner FROM v$session_connect_info
WHERE sid = SYS_CONTEXT('USERENV','SID');

-- Row 8: Audit & Logging
SELECT value FROM v$option WHERE parameter = 'Unified Auditing';
SELECT value FROM v$parameter WHERE name = 'audit_trail';
SELECT policy_name FROM audit_unified_enabled_policies;

SELECT MIN(event_timestamp) oldest, MAX(event_timestamp) newest, COUNT(*) records
FROM unified_audit_trail;

-- Row 9: RDS Managed Accounts (RDSADMIN)
SELECT username, account_status, last_login FROM dba_users WHERE username = 'RDSADMIN';

SELECT event_timestamp, userhost, client_program_name, action_name
FROM unified_audit_trail
WHERE dbusername = 'RDSADMIN'
  AND event_timestamp > SYSTIMESTAMP - INTERVAL '90' DAY
ORDER BY event_timestamp DESC;

SELECT sid, program, machine FROM v$session WHERE username = 'RDSADMIN';

-- Row 10: Performance & Capacity
SELECT tablespace_name, ROUND(used_percent,1) used_pct
FROM dba_tablespace_usage_metrics
ORDER BY used_percent DESC;

SELECT metric_name, ROUND(average,2) avg_val, ROUND(maxval,2) max_val
FROM v$sysmetric_summary
WHERE metric_name IN ('Host CPU Utilization (%)','Average Active Sessions');

-- Row 11: Account Classification
SELECT username, account_status, profile, authentication_type,
       created, last_login, expiry_date
FROM dba_users
WHERE oracle_maintained = 'N'
ORDER BY username;

-- Row 13: Password & Profile Controls
SELECT profile, resource_name, limit FROM dba_profiles
WHERE resource_name IN ('PASSWORD_LIFE_TIME','FAILED_LOGIN_ATTEMPTS',
                         'PASSWORD_LOCK_TIME','PASSWORD_REUSE_MAX',
                         'PASSWORD_VERIFY_FUNCTION')
ORDER BY profile, resource_name;

SELECT u.username, u.profile, p.limit
FROM dba_users u
JOIN dba_profiles p
  ON p.profile = u.profile AND p.resource_name = 'PASSWORD_LIFE_TIME'
WHERE u.oracle_maintained = 'N'
  AND (p.limit = 'UNLIMITED'
       OR (REGEXP_LIKE(p.limit,'^[0-9.]+$') AND TO_NUMBER(p.limit) > 90));

-- Row 14: Dormant / Terminated Accounts
SELECT username, last_login, created FROM dba_users
WHERE oracle_maintained = 'N'
  AND account_status = 'OPEN'
  AND (last_login IS NULL OR last_login < SYSTIMESTAMP - INTERVAL '90' DAY)
ORDER BY last_login NULLS FIRST;

-- Row 15: Least-Privilege Review
SELECT grantee, privilege, admin_option FROM dba_sys_privs
WHERE privilege LIKE '%ANY%'
  AND grantee NOT IN (SELECT username FROM dba_users WHERE oracle_maintained = 'Y')
  AND grantee NOT IN (SELECT role FROM dba_roles WHERE oracle_maintained = 'Y')
ORDER BY grantee;

SELECT owner, table_name, privilege FROM dba_tab_privs
WHERE grantee = 'PUBLIC'
  AND owner NOT IN (SELECT username FROM dba_users WHERE oracle_maintained = 'Y');

SELECT grantee, granted_role FROM dba_role_privs
WHERE granted_role IN ('DBA','EXP_FULL_DATABASE','IMP_FULL_DATABASE',
                       'SELECT_CATALOG_ROLE','EXECUTE_CATALOG_ROLE')
  AND grantee NOT IN (SELECT username FROM dba_users WHERE oracle_maintained = 'Y');

-- Row 16: Segregation of Duties
SELECT u.username,
       LISTAGG(r.granted_role, ', ') WITHIN GROUP (ORDER BY r.granted_role) roles
FROM dba_users u
LEFT JOIN dba_role_privs r ON r.grantee = u.username
WHERE u.oracle_maintained = 'N'
GROUP BY u.username
ORDER BY u.username;

-- Row 17: Sensitive Data Access (replace schema names)
SELECT grantee, owner, table_name, privilege FROM dba_tab_privs
WHERE owner IN ('YOUR_PII_SCHEMA','YOUR_PAYMENT_SCHEMA')
ORDER BY owner, table_name, grantee;

-- Row 18: Auditing & Alerts (Privileged Activity)
SELECT event_timestamp, dbusername, action_name, object_name, userhost
FROM unified_audit_trail
WHERE event_timestamp > SYSTIMESTAMP - INTERVAL '90' DAY
  AND action_name IN ('GRANT','REVOKE','CREATE USER','ALTER USER','DROP USER')
ORDER BY event_timestamp DESC;

-- Row 19: Database Links
SELECT owner, db_link, username, host, created FROM dba_db_links;

-- Row 20: Quotas & Resource Limits
SELECT username, tablespace_name, max_bytes FROM dba_ts_quotas
WHERE max_bytes = -1;

SELECT grantee FROM dba_sys_privs
WHERE privilege = 'UNLIMITED TABLESPACE'
  AND grantee NOT IN (SELECT username FROM dba_users WHERE oracle_maintained = 'Y');

-- Row 21: Lifecycle & Change Control
SELECT event_timestamp, dbusername, action_name, object_schema, object_name
FROM unified_audit_trail
WHERE event_timestamp > SYSTIMESTAMP - INTERVAL '90' DAY
  AND (action_name LIKE 'CREATE%' OR action_name LIKE 'ALTER%' OR action_name LIKE 'DROP%')
ORDER BY event_timestamp DESC;




