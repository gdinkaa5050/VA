SELECT object_name, object_type, status, last_ddl_time
FROM all_objects
WHERE object_name = 'ALPS_INFO_MTGE_LOAN'
AND object_type IN ('PACKAGE','PACKAGE BODY');


SELECT object_name, procedure_name, overload
FROM all_procedures
WHERE object_name = 'ALPS_INFO_MTGE_LOAN'
AND procedure_name = 'LOAN_DETAIL_BY_ID';

SELECT text
FROM all_source
WHERE name = 'ALPS_INFO_MTGE_LOAN'
AND type = 'PACKAGE BODY'
ORDER BY line;


identify the account
SELECT dbusername, action_name, object_schema, object_name, event_timestamp, client_program_name, userhost
FROM unified_audit_trail
WHERE object_name = 'ALPS_INFO_HERS'
ORDER BY event_timestamp DESC
FETCH FIRST 20 ROWS ONLY;


SELECT s.username, s.program, s.machine, s.logon_time, sq.sql_text
FROM v$session s
JOIN v$sql sq ON s.sql_id = sq.sql_id
WHERE sq.sql_text LIKE '%ALPS_INFO_HERS%';


SELECT username, action_name, obj_name, timestamp, userhost
FROM dba_audit_trail
WHERE obj_name = 'ALPS_INFO_HERS'
ORDER BY timestamp DESC;

SELECT owner, name, type
FROM dba_dependencies
WHERE referenced_name = 'ALPS_INFO_HERS';

SELECT policy_name, audit_option, object_schema, object_name
FROM audit_unified_enabled_policies aep
JOIN audit_unified_policies aup ON aep.policy_name = aup.policy_name
WHERE aup.object_name = 'ALPS_INFO_HERS' OR aup.audit_option LIKE '%EXECUTE%';

SELECT dbusername, action_name, object_schema, object_name, event_timestamp, client_program_name
FROM unified_audit_trail
WHERE event_timestamp > SYSDATE - 7
AND (object_name LIKE '%HERS%' OR client_program_name IS NOT NULL)
ORDER BY event_timestamp DESC
FETCH FIRST 50 ROWS ONLY;

SELECT username, program, machine, osuser, logon_time
FROM v$session
WHERE program NOT LIKE '%sqldeveloper%' AND program NOT LIKE '%sqlplus%';

SELECT username, program, machine, osuser, logon_time
FROM v$session
WHERE username IS NOT NULL
ORDER BY logon_time DESC;
