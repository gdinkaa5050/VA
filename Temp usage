SELECT ROUND(SUM(bytes)/1024/1024/1024,1)    AS size_gb,
       ROUND(SUM(maxbytes)/1024/1024/1024,1) AS max_gb
FROM dba_temp_files
WHERE tablespace_name = 'TEMP';


--peak temp
SELECT MAX(tot)/1024/1024/1024 AS peak_temp_gb
FROM (
  SELECT sample_time, SUM(temp_space_allocated) tot
  FROM dba_hist_active_sess_history
  WHERE sample_time BETWEEN TIMESTAMP '2026-11-01 14:00:00'
                        AND TIMESTAMP '2026-11-01 20:30:00'
  GROUP BY sample_time
);


--top statement
SELECT sql_id, ROUND(MAX(tot)/1024/1024/1024,1) AS temp_gb
FROM (
  SELECT sql_id, sample_time, SUM(temp_space_allocated) tot
  FROM dba_hist_active_sess_history
  WHERE sample_time BETWEEN TIMESTAMP '2026-11-01 14:00:00'
                        AND TIMESTAMP '2026-11-01 20:30:00'
  GROUP BY sql_id, sample_time
)
GROUP BY sql_id
ORDER BY temp_gb DESC NULLS LAST
FETCH FIRST 5 ROWS ONLY;

--how temp is configured 
SELECT file_name, ROUND(bytes/1024/1024/1024,1) AS gb,
       autoextensible, increment_by
FROM dba_temp_files WHERE tablespace_name = 'TEMP';

SELECT ROUND(tablespace_size/1024/1024/1024,1) AS total_gb,
       ROUND(allocated_space/1024/1024/1024,1) AS allocated_gb,
       ROUND(free_space/1024/1024/1024,1)      AS free_gb
FROM dba_temp_free_space WHERE tablespace_name = 'TEMP';

--hour analysis 
SELECT TO_CHAR(sample_time,'YYYY-MM-DD HH24') AS hr,
       COUNT(*) AS samples,
       ROUND(MAX(tot)/1024/1024/1024,1) AS peak_temp_gb
FROM (
  SELECT ash.sample_time, SUM(ash.temp_space_allocated) tot
  FROM dba_hist_active_sess_history ash
  JOIN dba_users u ON u.user_id = ash.user_id
  WHERE u.username = 'ANALYTICS'
  AND ash.sample_time >= TIMESTAMP '2026-10-31 18:00:00'
  AND ash.sample_time <  TIMESTAMP '2026-11-02 06:00:00'
  GROUP BY ash.sample_time
)
GROUP BY TO_CHAR(sample_time,'YYYY-MM-DD HH24')
ORDER BY 1;

--awr
SELECT snap_id, begin_interval_time, end_interval_time
FROM dba_hist_snapshot
WHERE begin_interval_time >= TIMESTAMP '2026-10-31 00:00:00'
AND   begin_interval_time <  TIMESTAMP '2026-11-03 00:00:00'
ORDER BY snap_id;

--when did temp grow
SELECT s.begin_interval_time,
       ROUND(u.tablespace_size     * 8192/1024/1024/1024) AS size_gb,
       ROUND(u.tablespace_usedsize * 8192/1024/1024/1024) AS used_gb
FROM dba_hist_tbspc_space_usage u
JOIN dba_hist_snapshot s ON s.snap_id = u.snap_id AND s.dbid = u.dbid
JOIN v$tablespace t      ON t.ts# = u.tablespace_id
WHERE t.name = 'TEMP'
AND s.begin_interval_time >= TIMESTAMP '2026-10-28 00:00:00'
ORDER BY s.begin_interval_time;

--active user during etl
SELECT u.username, COUNT(*) AS samples,
       ROUND(MAX(ash.temp_space_allocated)/1024/1024/1024,1) AS max_session_temp_gb
FROM dba_hist_active_sess_history ash
LEFT JOIN dba_users u ON u.user_id = ash.user_id
WHERE ash.sample_time >= TIMESTAMP '2026-11-01 13:00:00'
AND   ash.sample_time <  TIMESTAMP '2026-11-01 22:00:00'
GROUP BY u.username
ORDER BY samples DESC;



