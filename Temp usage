--###solution
-- Raise retention to 45 days
EXEC DBMS_WORKLOAD_REPOSITORY.MODIFY_SNAPSHOT_SETTINGS(retention => 64800);

-- Find the snapshot IDs covering the Nov 1 run
SELECT snap_id, begin_interval_time FROM dba_hist_snapshot
WHERE begin_interval_time BETWEEN TIMESTAMP '2026-11-01 13:00:00'
                              AND TIMESTAMP '2026-11-01 21:30:00'
ORDER BY snap_id;

-- Keep those snapshots permanently as a baseline (use the first and last snap_id)
EXEC DBMS_WORKLOAD_REPOSITORY.CREATE_BASELINE(start_snap_id => <first>, end_snap_id => <last>, baseline_name => 'MONTHLY_ETL_NOV2026');

