--did the plan change
SELECT q.sql_id, s.begin_interval_time, q.plan_hash_value,
       q.executions_delta AS execs,
       ROUND(q.elapsed_time_delta/1e6/60,1) AS elapsed_min,
       q.rows_processed_delta AS rows_processed
FROM dba_hist_sqlstat q
JOIN dba_hist_snapshot s
  ON s.snap_id = q.snap_id AND s.dbid = q.dbid
 AND s.instance_number = q.instance_number
WHERE q.sql_id IN ('1f5cbmms15k15','b2907zzhs8py0','73a1r4j3sgbcn','4snmuygrcysws')
ORDER BY q.sql_id, s.begin_interval_time;


