--which statement took much time Nov1
SELECT ash.sql_id,
       ROUND(COUNT(DISTINCT ash.sample_time)*10/60) AS approx_min,
       COUNT(*) AS samples
FROM dba_hist_active_sess_history ash
JOIN dba_users u ON u.user_id = ash.user_id
WHERE u.username = 'ANALYTICS'
AND ash.sample_time BETWEEN TIMESTAMP '2026-11-01 14:00:00'
                        AND TIMESTAMP '2026-11-01 20:30:00'
GROUP BY ash.sql_id
ORDER BY approx_min DESC
FETCH FIRST 10 ROWS ONLY;


--next
