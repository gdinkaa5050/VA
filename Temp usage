       u.username,
       ROUND(COUNT(DISTINCT ash.sample_time)*10/60) AS approx_min,
       COUNT(*) AS samples
FROM dba_hist_active_sess_history ash
LEFT JOIN dba_users u ON u.user_id = ash.user_id
WHERE ash.sample_time BETWEEN TIMESTAMP '2026-11-01 14:00:00'
                          AND TIMESTAMP '2026-11-01 20:30:00'
