SELECT DISTINCT 'ALTER DEFAULT PRIVILEGES FOR USER ' || quote_ident(owner_name)
       || CASE WHEN schema_name IS NOT NULL THEN ' IN SCHEMA ' || quote_ident(schema_name) ELSE '' END
       || ' REVOKE ALL ON '
       || CASE object_type WHEN 'RELATION' THEN 'TABLES'
                           WHEN 'FUNCTION' THEN 'FUNCTIONS'
                           WHEN 'PROCEDURE' THEN 'PROCEDURES' END
       || ' FROM '
       || CASE WHEN grantee_type = 'group' THEN 'GROUP ' || quote_ident(grantee_name)
               WHEN grantee_type = 'role'  THEN 'ROLE '  || quote_ident(grantee_name)
