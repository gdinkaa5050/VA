SELECT nspname, pg_get_userbyid(nspowner) AS owner FROM pg_namespace WHERE nspname = 'admin';


--reassigning the object to glue dev service

-- Tables and views
SELECT 'ALTER TABLE ' || quote_ident(TRIM(n.nspname)) || '.' || quote_ident(TRIM(c.relname))
       || ' OWNER TO glue_uat_service;' AS ddl
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
JOIN pg_user u ON u.usesysid = c.relowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana')
  AND c.relkind IN ('r','v')

UNION ALL

-- Schemas
SELECT 'ALTER SCHEMA ' || quote_ident(TRIM(n.nspname)) || ' OWNER TO glue_uat_service;'
FROM pg_namespace n
JOIN pg_user u ON u.usesysid = n.nspowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana')

UNION ALL

-- Functions and stored procedures
SELECT 'ALTER ' || CASE WHEN p.prokind = 'p' THEN 'PROCEDURE ' ELSE 'FUNCTION ' END
       || quote_ident(TRIM(n.nspname)) || '.' || quote_ident(TRIM(p.proname))
       || '(' || oidvectortypes(p.proargtypes) || ') OWNER TO glue_uat_service;'
FROM pg_proc_info p
JOIN pg_namespace n ON n.oid = p.pronamespace
JOIN pg_user u ON u.usesysid = p.proowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana');

--check
SELECT COUNT(*) AS tables_views_left
FROM pg_class c
JOIN pg_user u ON u.usesysid = c.relowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana')
  AND c.relkind IN ('r','v');

SELECT COUNT(*) AS schemas_left
FROM pg_namespace n
JOIN pg_user u ON u.usesysid = n.nspowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana');

SELECT COUNT(*) AS functions_left
FROM pg_proc p
JOIN pg_user u ON u.usesysid = p.proowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana');




