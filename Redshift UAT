SELECT usename, usesysid, usesuper
FROM pg_user
WHERE usename IN ('glue_uat_service','moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana');

SELECT u.usename AS old_owner, TRIM(n.nspname) AS schema_name,
       TRIM(c.relname) AS object_name,
       CASE c.relkind WHEN 'r' THEN 'table' ELSE 'view' END AS object_type
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
JOIN pg_user u ON u.usesysid = c.relowner
WHERE u.usename IN ('moses_vo','katie_brewster','matt_eden','seshagiri_rao_muddana')
  AND c.relkind IN ('r','v')
ORDER BY 1, 2, 3;

--check admin user
