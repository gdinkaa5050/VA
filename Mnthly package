END ETL_EMAIL_PKG;
/

SHOW ERRORS PACKAGE BODY ANALYTICS.ETL_EMAIL_PKG;


STEP 3: Test both package procedures manually
----------------------------------------------------------------
-- Redirect recipients to yourself first if not already validated
-- this way.

EXEC ANALYTICS.ETL_EMAIL_PKG.daily_etl_notify;
EXEC ANALYTICS.ETL_EMAIL_PKG.monthly_etl_notify;


STEP 4: Repoint both scheduler jobs to the package procedures
----------------------------------------------------------------
BEGIN
  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE(
    name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB',
    attribute => 'JOB_ACTION',
    value     => 'ETL_EMAIL_PKG.DAILY_ETL_NOTIFY'
  );
END;
/

BEGIN
  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE(
    name      => 'ANALYTICS.MONTHLY_ETL_EMAIL_JOB',
    attribute => 'JOB_ACTION',
    value     => 'ETL_EMAIL_PKG.MONTHLY_ETL_NOTIFY'
  );
END;
/

-- Confirm both jobs now point to the package
SELECT job_name, job_action, repeat_interval, enabled
FROM dba_scheduler_jobs
WHERE job_name IN ('DAILY_ETL_EMAIL_JOB', 'MONTHLY_ETL_EMAIL_JOB')
  AND owner = 'ANALYTICS';


