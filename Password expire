   -- Who can execute the network packages today?
   SELECT grantee, table_name, privilege FROM dba_tab_privs
    WHERE table_name IN ('UTL_SMTP','UTL_TCP');
   -- Existing ACLs
   SELECT host, lower_port, upper_port, principal, privilege FROM dba_host_aces;
*/

/* ---------------------------------------------------------------------------
   1. SCHEMA + PRIVILEGES  (run as SYS or DBA)
   NO AUTHENTICATION = schema-only account: nobody can log in to it and it
   has no password to expire. On 12c use instead:
     CREATE USER dbamon IDENTIFIED BY "<long random>" ACCOUNT LOCK ...
   --------------------------------------------------------------------------- */
CREATE USER dbamon NO AUTHENTICATION
  DEFAULT TABLESPACE &app_tbs
  QUOTA 200M ON &app_tbs;

GRANT CREATE TABLE, CREATE PROCEDURE, CREATE JOB TO dbamon;
GRANT SELECT  ON sys.dba_users TO dbamon;   -- direct grant needed for PL/SQL
GRANT EXECUTE ON sys.utl_smtp  TO dbamon;
GRANT EXECUTE ON sys.utl_tcp   TO dbamon;

/* ---------------------------------------------------------------------------
   2. NETWORK ACL  (12c+; lets DBAMON open a connection to the SMTP relay only)
   --------------------------------------------------------------------------- */
BEGIN
  DBMS_NETWORK_ACL_ADMIN.APPEND_HOST_ACE(
    host       => '&smtp_host',
    lower_port => &smtp_port,
    upper_port => &smtp_port,
    ace        => xs$ace_type(
                    privilege_list => xs$name_list('connect','resolve','smtp'),
                    principal_name => 'DBAMON',
                    principal_type => xs_acl.ptype_db));
END;
/

