--when was the password changed 
SELECT u.username, u.account_status, u.profile, u.created,
       u.expiry_date,
       u.expiry_date - TO_NUMBER(p.limit)  AS approx_changed_on,  -- expiry minus 90-day life
       u.password_change_date,   -- delete this line if you get ORA-00904
       u.last_login, u.lock_date
FROM dba_users u
JOIN dba_profiles p ON p.profile = u.profile
 AND p.resource_name = 'PASSWORD_LIFE_TIME'
WHERE u.username = 'ORACLE';

--check audit is on
SELECT policy_name, enabled_option, entity_name, success, failure
FROM audit_unified_enabled_policies
ORDER BY policy_name;

--who changed it
SELECT FROM_TZ(event_timestamp, 'UTC') AT TIME ZONE 'America/Chicago' AS changed_at_ct,
       dbusername        AS changed_by,
       os_username, userhost, terminal, client_program_name,
       action_name, object_name, target_user, return_code,
       unified_audit_policies, sql_text            -- passwords are masked
FROM unified_audit_trail
WHERE (action_name = 'ALTER USER' OR action_name LIKE '%PASSWORD%')
  AND (object_name = 'ORACLE' OR target_user = 'ORACLE')
  AND event_timestamp > SYSTIMESTAMP - INTERVAL '30' DAY
ORDER BY event_timestamp DESC;

--check audit again
SELECT extended_timestamp, username AS changed_by, os_username,
       userhost, terminal, action_name, obj_name, returncode
FROM dba_audit_trail
WHERE action_name = 'ALTER USER' AND obj_name = 'ORACLE'
ORDER BY timestamp DESC;

--is something else using it
SELECT TRUNC(FROM_TZ(event_timestamp,'UTC') AT TIME ZONE 'America/Chicago') AS day_ct,
       userhost, os_username, client_program_name,
       return_code,            -- 0 = ok, 1017 = wrong password, 28000 = locked
       COUNT(*) AS attempts
FROM unified_audit_trail
WHERE dbusername = 'ORACLE'
  AND action_name = 'LOGON'
  AND event_timestamp > SYSTIMESTAMP - INTERVAL '14' DAY
GROUP BY TRUNC(FROM_TZ(event_timestamp,'UTC') AT TIME ZONE 'America/Chicago'),
         userhost, os_username, client_program_name, return_code
ORDER BY day_ct DESC, attempts DESC;

--who is connected as oracle right 
SELECT sid, serial#, osuser, machine, program, module, logon_time, status
FROM v$session
WHERE username = 'ORACLE'
ORDER BY logon_time;
