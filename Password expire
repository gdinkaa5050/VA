/* ---------------------------------------------------------------------------
   7. SCHEDULER JOB  -- daily 07:00 Central, DST-aware
   NOTE: the first real run immediately emails everyone already within
   14 days of expiry (that covers the users you saw today).
   --------------------------------------------------------------------------- */
BEGIN
  DBMS_SCHEDULER.create_job(
    job_name        => 'DBAMON.PWD_EXPIRY_NOTIFY_JOB',
    job_type        => 'STORED_PROCEDURE',
    job_action      => 'DBAMON.PWD_EXPIRY_NOTIFY.RUN',
    start_date      => TO_TIMESTAMP_TZ(
                         TO_CHAR(TRUNC(SYSDATE) + 1, 'YYYY-MM-DD')
                         || ' 07:00:00 America/Chicago',
                         'YYYY-MM-DD HH24:MI:SS TZR'),
    repeat_interval => 'FREQ=DAILY;BYHOUR=7;BYMINUTE=0;BYSECOND=0',
    enabled         => TRUE,
    comments        => 'Emails users before Oracle password expiry; daily DBA summary');
END;
/

