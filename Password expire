SELECT username, account_status, expiry_date FROM dba_users
WHERE profile = 'VALERI' ORDER BY expiry_date;

SELECT username, account_status, expiry_date FROM dba_users
WHERE profile = 'DEFAULT' AND account_status LIKE 'OPEN%';


--days idle
SELECT username, account_status, last_login,
       TRUNC(SYSDATE - CAST(last_login AS DATE)) AS idle_days
FROM dba_users WHERE profile = 'VALERI' ORDER BY last_login;

--check if user migr owns anything
SELECT object_type, COUNT(*) FROM dba_objects
WHERE owner = 'MIGR' GROUP BY object_type;


SELECT owner, job_name, enabled, last_start_date, job_action
FROM dba_scheduler_jobs
WHERE UPPER(job_action) LIKE '%MAIL%' OR UPPER(job_name) LIKE '%PASS%' OR UPPER(job_name) LIKE '%EXPIR%';

SELECT DISTINCT owner, name, type
FROM dba_source
WHERE UPPER(text) LIKE '%UTL_MAIL%' OR UPPER(text) LIKE '%UTL_SMTP%';

SELECT resource_name, limit FROM dba_profiles
WHERE profile IN ('VA_USERS','ADMIN_PRFL') AND resource_type='PASSWORD';

SELECT username, account_status, expiry_date, lock_date
FROM dba_users WHERE account_status <> 'OPEN';

