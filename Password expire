SELECT u.profile, p.limit AS life_days,
       COUNT(*) AS users,
       SUM(CASE WHEN u.oracle_maintained='Y' THEN 1 ELSE 0 END) AS oracle_accts
FROM dba_users u
JOIN dba_profiles p ON p.profile = u.profile
 AND p.resource_name = 'PASSWORD_LIFE_TIME'
GROUP BY u.profile, p.limit
ORDER BY u.profile;

