/* ---------------------------------------------------------------------------
   5. PACKAGE
   --------------------------------------------------------------------------- */
CREATE OR REPLACE PACKAGE pwd_expiry_notify AUTHID DEFINER AS
  -- p_dry_run     TRUE  = print emails to DBMS_OUTPUT; send and log nothing
  -- p_redirect_to email = send every message to this address; log nothing
  PROCEDURE run (p_dry_run     IN BOOLEAN  DEFAULT FALSE,
                 p_redirect_to IN VARCHAR2 DEFAULT NULL);
END pwd_expiry_notify;
/

CREATE OR REPLACE PACKAGE BODY pwd_expiry_notify AS

  crlf        CONSTANT VARCHAR2(2)    := CHR(13) || CHR(10);
  c_smtp_host CONSTANT VARCHAR2(255)  := '&smtp_host';
  c_smtp_port CONSTANT PLS_INTEGER    := &smtp_port;
  c_from      CONSTANT VARCHAR2(320)  := '&mail_from';
  c_dba_team  CONSTANT VARCHAR2(1000) := '&dba_team';
  c_ticket_q  CONSTANT VARCHAR2(200)  := '&ticket_q';
  c_db_label  CONSTANT VARCHAR2(100)  := '&db_label';
  c_max_days  CONSTANT PLS_INTEGER    := 14;   -- people: email from 14 days
  c_svc_days  CONSTANT PLS_INTEGER    := 30;   -- service: DBA summary from 30
  c_idle_days CONSTANT PLS_INTEGER    := 45;   -- service idle warning
  c_keep_days CONSTANT PLS_INTEGER    := 365;  -- log retention

  g_dry_run   BOOLEAN := FALSE;
  g_redirect  VARCHAR2(1000);

  -- Days left -> notification threshold (14, 7, 3, 1, 0 = grace)
  FUNCTION bucket (p_days NUMBER) RETURN PLS_INTEGER IS
  BEGIN
    RETURN CASE
             WHEN p_days <= 0 THEN 0
             WHEN p_days <= 1 THEN 1
             WHEN p_days <= 3 THEN 3
             WHEN p_days <= 7 THEN 7
             ELSE 14
           END;
  END bucket;

  PROCEDURE add_line (p_buf IN OUT NOCOPY VARCHAR2, p_line IN VARCHAR2) IS
  BEGIN
    IF NVL(LENGTH(p_buf), 0) + NVL(LENGTH(p_line), 0) < 30000 THEN
      p_buf := p_buf || p_line || crlf;
    END IF;
  END add_line;

  -- p_to may hold several addresses separated by commas or semicolons
  PROCEDURE send_mail (p_to IN VARCHAR2, p_subject IN VARCHAR2, p_body IN VARCHAR2) IS
    c       UTL_SMTP.connection;
    v_to    VARCHAR2(1000) := REPLACE(NVL(g_redirect, p_to), ' ');
    v_addr  VARCHAR2(320);
    n       PLS_INTEGER := 1;
  BEGIN
    IF g_dry_run THEN
      DBMS_OUTPUT.put_line('==== DRY RUN  To: ' || v_to);
      DBMS_OUTPUT.put_line('Subject: ' || p_subject);
      DBMS_OUTPUT.put_line(REPLACE(p_body, CHR(13)));
      RETURN;
    END IF;

    c := UTL_SMTP.open_connection(c_smtp_host, c_smtp_port);
    UTL_SMTP.helo(c, SUBSTR(c_from, INSTR(c_from, '@') + 1));
    UTL_SMTP.mail(c, c_from);
    LOOP
      v_addr := REGEXP_SUBSTR(v_to, '[^,;]+', 1, n);
      EXIT WHEN v_addr IS NULL;
      UTL_SMTP.rcpt(c, v_addr);
      n := n + 1;
    END LOOP;
    UTL_SMTP.open_data(c);
    UTL_SMTP.write_data(c,
         'Date: ' || TO_CHAR(SYSTIMESTAMP, 'Dy, DD Mon YYYY HH24:MI:SS TZHTZM',
                             'NLS_DATE_LANGUAGE=ENGLISH') || crlf
      || 'From: ' || c_from || crlf
      || 'To: '   || REPLACE(v_to, ';', ',') || crlf
      || 'Subject: ' || p_subject || crlf
      || 'MIME-Version: 1.0' || crlf
      || 'Content-Type: text/plain; charset=us-ascii' || crlf
      || crlf
      || p_body);
    UTL_SMTP.close_data(c);
    UTL_SMTP.quit(c);
  EXCEPTION
    WHEN OTHERS THEN
      BEGIN UTL_SMTP.quit(c); EXCEPTION WHEN OTHERS THEN NULL; END;
      RAISE;
  END send_mail;

  FUNCTION user_body (p_name VARCHAR2, p_user VARCHAR2,
                      p_expiry DATE, p_days NUMBER) RETURN VARCHAR2 IS
  BEGIN
    RETURN
         'Hello ' || NVL(p_name, p_user) || ',' || crlf || crlf
      || 'The password for your Oracle account ' || p_user
      || ' on database ' || c_db_label
      || CASE
           WHEN p_days <= 0 THEN
             ' has expired and is now in its grace period. You will be'
             || ' required to change it at your next login.'
           ELSE
             ' expires on ' || TO_CHAR(p_expiry, 'Dy DD-Mon-YYYY HH:MI AM')
             || ' Central (in ' || p_days || ' day(s)).'
         END || crlf || crlf
      || 'Please change it before then to avoid losing access:' || crlf
      || '  - SQL Developer or Toad: use the Change/Reset Password option' || crlf
      || '  - SQL*Plus or SQLcl: connect, then type the command: password' || crlf
      || crlf
      || 'Reminders: the new password must meet complexity requirements and'
      || ' cannot match a previous password. Your account locks after 3'
      || ' failed login attempts.' || crlf || crlf
      || 'If you are locked out or need help, open a ticket with '
      || c_ticket_q || '.' || crlf
      || 'The DBA team will never ask for your password. This message'
      || ' contains no links.' || crlf || crlf
      || 'Database Administration' || crlf
      || '(Automated notice - please do not reply)' || crlf;
  END user_body;

  FUNCTION already_sent (p_user VARCHAR2, p_expiry DATE, p_bucket NUMBER)
    RETURN BOOLEAN IS
    v_cnt NUMBER;
  BEGIN
    SELECT COUNT(*) INTO v_cnt
      FROM pwd_notify_log
     WHERE username       = p_user
       AND expiry_date    = p_expiry
       AND threshold_days = p_bucket
       AND status         = 'SENT';
    RETURN v_cnt > 0;
  END already_sent;

  PROCEDURE log_it (p_user VARCHAR2, p_expiry DATE, p_bucket NUMBER,
                    p_email VARCHAR2, p_status VARCHAR2, p_err VARCHAR2) IS
  BEGIN
    IF g_dry_run OR g_redirect IS NOT NULL THEN
      RETURN;   -- tests must never suppress real notifications
    END IF;
    INSERT INTO pwd_notify_log
      (username, expiry_date, threshold_days, email, status, error_msg)
    VALUES
      (p_user, p_expiry, p_bucket, p_email, p_status, SUBSTR(p_err, 1, 4000));
    COMMIT;
  END log_it;

  PROCEDURE run (p_dry_run     IN BOOLEAN  DEFAULT FALSE,
                 p_redirect_to IN VARCHAR2 DEFAULT NULL) IS
    v_sent      VARCHAR2(32767);
    v_service   VARCHAR2(32767);
    v_idle      VARCHAR2(32767);
    v_nocontact VARCHAR2(32767);
    v_failed    VARCHAR2(32767);
    v_expired   VARCHAR2(32767);
    v_bucket    PLS_INTEGER;
    v_line      VARCHAR2(1000);
    v_subject   VARCHAR2(300);
    v_err       VARCHAR2(4000);
  BEGIN
    g_dry_run  := NVL(p_dry_run, FALSE);
    g_redirect := p_redirect_to;

    -- 1. Accounts approaching expiry
    FOR r IN (
      SELECT u.username,
             u.account_status,
             u.expiry_date,
             TRUNC(u.expiry_date) - TRUNC(SYSDATE) AS days_left,
             c.full_name,
             c.email,
             CASE WHEN u.oracle_maintained = 'Y' THEN 'SERVICE'
                  ELSE NVL(c.account_type, 'HUMAN') END AS account_type,
             NVL(c.notify, 'Y') AS notify
        FROM dba_users u
        JOIN pwd_notify_profiles p ON p.profile = u.profile
        LEFT JOIN pwd_notify_contacts c ON c.username = u.username
       WHERE u.username NOT IN ('RDSADMIN', 'RDSSEC', 'RDS_DATAGUARD')
         AND u.expiry_date IS NOT NULL
         AND u.account_status IN ('OPEN', 'EXPIRED(GRACE)')
         AND TRUNC(u.expiry_date) - TRUNC(SYSDATE) <= GREATEST(c_max_days, c_svc_days)
       ORDER BY u.expiry_date)
    LOOP
      v_bucket := bucket(r.days_left);
      v_line   := RPAD(r.username, 30) || ' '
               || TO_CHAR(r.expiry_date, 'YYYY-MM-DD HH24:MI') || '  '
               || LPAD(r.days_left, 3) || ' day(s)  ' || r.account_status;

      IF r.notify = 'N' THEN
        NULL;                                         -- excluded on purpose
      ELSIF r.account_type <> 'SERVICE' AND r.days_left > c_max_days THEN
        NULL;                                         -- person, not due yet
      ELSIF r.account_type = 'SERVICE' THEN
        add_line(v_service, v_line || '  ' || r.full_name);
      ELSIF already_sent(r.username, r.expiry_date, v_bucket) THEN
        NULL;                                         -- already notified
      ELSIF r.email IS NULL THEN
        add_line(v_nocontact, v_line);
      ELSE
        BEGIN
          v_subject :=
               CASE WHEN v_bucket = 0  THEN 'URGENT: '
                    WHEN v_bucket <= 3 THEN 'Action needed: '
                    ELSE 'Reminder: ' END
            || 'Oracle password for ' || r.username || ' on ' || c_db_label
            || CASE WHEN r.days_left <= 0 THEN ' has expired'
                    ELSE ' expires in ' || r.days_left || ' day(s)' END;

          send_mail(r.email, v_subject,
                    user_body(r.full_name, r.username, r.expiry_date, r.days_left));
          log_it(r.username, r.expiry_date, v_bucket, r.email, 'SENT', NULL);
          add_line(v_sent, v_line || '  -> ' || r.email);
        EXCEPTION
          WHEN OTHERS THEN
            v_err := SQLERRM;
            log_it(r.username, r.expiry_date, v_bucket, r.email, 'FAILED', v_err);
            add_line(v_failed, v_line || '  ' || v_err);
        END;
      END IF;
    END LOOP;

    -- 2. Service accounts idle long enough to risk an inactivity lock
    FOR s IN (
      SELECT u.username, u.profile, c.full_name,
             TRUNC(SYSDATE - NVL(CAST(u.last_login AS DATE), u.created)) AS idle_days,
             CASE WHEN u.last_login IS NULL THEN 'never logged in' ELSE 'last login' END AS basis
        FROM dba_users u
        JOIN pwd_notify_contacts c ON c.username = u.username
       WHERE c.account_type = 'SERVICE'
         AND c.notify = 'Y'
         AND u.account_status = 'OPEN'
         AND NVL(CAST(u.last_login AS DATE), u.created) < SYSDATE - c_idle_days
       ORDER BY 4 DESC)
    LOOP
      add_line(v_idle, RPAD(s.username, 30) || ' ' || LPAD(s.idle_days, 4)
                    || ' days idle (' || s.basis || ')  ' || s.profile
                    || '  ' || s.full_name);
    END LOOP;

    -- 3. Fully expired accounts (past grace) in the last 30 days
    FOR e IN (
      SELECT u.username, u.expiry_date, u.account_status
        FROM dba_users u
        JOIN pwd_notify_profiles p ON p.profile = u.profile
       WHERE u.oracle_maintained = 'N'
         AND u.account_status LIKE 'EXPIRED%'
         AND u.account_status NOT LIKE '%GRACE%'
         AND u.expiry_date > SYSDATE - 30
       ORDER BY u.expiry_date)
    LOOP
      add_line(v_expired, RPAD(e.username, 30) || ' '
                       || TO_CHAR(e.expiry_date, 'YYYY-MM-DD HH24:MI') || '  '
                       || e.account_status);
    END LOOP;

    -- 4. DBA summary, only when there is something to report
    IF COALESCE(v_sent, v_service, v_idle, v_nocontact, v_failed, v_expired) IS NOT NULL THEN
      send_mail(c_dba_team,
                'Oracle password expiry report - ' || c_db_label || ' - '
                || TO_CHAR(SYSDATE, 'YYYY-MM-DD'),
           'Password expiry report for ' || c_db_label
        || ' (' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI') || ' Central)' || crlf || crlf
        || 'SEND FAILURES - investigate:' || crlf
        || NVL(v_failed, '  none' || crlf) || crlf
        || 'SERVICE / ADMIN ACCOUNTS EXPIRING (30 days) - rotate under change control:' || crlf
        || NVL(v_service, '  none' || crlf) || crlf
        || 'SERVICE ACCOUNTS IDLE ' || c_idle_days || '+ DAYS - may auto-lock:' || crlf
        || NVL(v_idle, '  none' || crlf) || crlf
        || 'NO EMAIL ON FILE - add to DBAMON.PWD_NOTIFY_CONTACTS:' || crlf
        || NVL(v_nocontact, '  none' || crlf) || crlf
        || 'ALREADY EXPIRED (last 30 days):' || crlf
        || NVL(v_expired, '  none' || crlf) || crlf
        || 'USERS EMAILED TODAY:' || crlf
        || NVL(v_sent, '  none' || crlf));
    END IF;

    -- 5. Housekeeping
    IF NOT g_dry_run AND g_redirect IS NULL THEN
      DELETE FROM pwd_notify_log
       WHERE sent_at < SYSTIMESTAMP - NUMTODSINTERVAL(c_keep_days, 'DAY');
      COMMIT;
    END IF;
  END run;

END pwd_expiry_notify;
/

