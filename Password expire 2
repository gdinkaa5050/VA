/* =============================================================================
   ORACLE PASSWORD-EXPIRY EMAIL NOTIFICATIONS  --  Amazon RDS for Oracle
   -----------------------------------------------------------------------------
   WHAT IT DOES (runs daily 07:00 America/Chicago)

   People (VA_USERS profile, and named admins)
     - Each person gets ONE email about THEIR OWN account only, at
       14, 7, 3 and 1 days before expiry, plus once in the grace period.
     - Never emailed twice for the same threshold; catches up if a run
       is missed (weekend, outage).

   DBA team (dba1 + dba2) - one daily summary, only when there is news:
     - Send failures
     - Service/admin accounts expiring within 30 days (repeats daily
       until rotated - time for change control)
     - Service accounts idle 45+ days (VALERI profile auto-locks at 60)
     - Users with no email on file
     - Accounts already fully expired (last 30 days)
     - Which users were emailed today

   Emails contain no links and no passwords (phishing-safe).

   REQUIREMENTS
     - Run as the RDS master user (SQL*Plus / SQLcl / SQL Developer /
       Toad: Execute as Script, F5).
     - RDS security group / NACL must allow OUTBOUND traffic from the DB
       instance to the SMTP relay; the relay must accept mail from the
       instance IP (network / email team request).
     - Oracle 19c (NO AUTHENTICATION needs 18c+).

   PRODUCTION
     - Change control; test in DEV/TEST first.
     - UTL_SMTP / UTL_TCP grants and the network ACL may need ISSO /
       security approval. Document it.

   SECTIONS
     0  Settings (EDIT)          5  Package
     1  Schema + privileges      6  Test (dry run, redirect)
     2  Network ACL              7  Scheduler job
     3  Tables                   8  Monitoring queries
     4  Seed data (EDIT)         9  Rollback
     4b Validate contacts
   ============================================================================= */

SET DEFINE ON
SET SERVEROUTPUT ON SIZE UNLIMITED

/* ---------------------------------------------------------------------------
   0. SETTINGS  -- EDIT
   --------------------------------------------------------------------------- */
-- Replace every value in angle brackets, INCLUDING the brackets.
-- Example:  '<smtp.your-relay.va.gov>'  becomes  'smtp.relay.va.gov'
DEFINE smtp_host = '<smtp.your-relay.va.gov>'
DEFINE smtp_port = <25>
DEFINE mail_from = '<oracle-dba-noreply@va.gov>'
DEFINE dba_team  = '<dba1@va.gov>,<dba2@va.gov>'
DEFINE ticket_q  = '<name of your DBA ticket queue>'
DEFINE db_label  = '<VAL_PROD>'
DEFINE app_tbs   = '<USERS>'

-- Safety stop: the script halts here if any setting above was not edited.
WHENEVER SQLERROR EXIT FAILURE ROLLBACK
BEGIN
  IF INSTR(q'[&smtp_host|&smtp_port|&mail_from|&dba_team|&ticket_q|&db_label|&app_tbs]', '<') > 0 THEN
    RAISE_APPLICATION_ERROR(-20001,
      'Section 0 still contains angle-bracket placeholders. Edit them first.');
  END IF;
END;
/
WHENEVER SQLERROR CONTINUE

/* Pre-checks (run by hand, review output):
   -- From a host in the same VPC/subnet as RDS, can you reach the relay?
   --   nc -vz <smtp.your-relay.va.gov> 25
   SELECT grantee, table_name, privilege FROM dba_tab_privs
    WHERE table_name IN ('UTL_SMTP','UTL_TCP');
   SELECT host, lower_port, upper_port, principal, privilege FROM dba_host_aces;
*/

/* ---------------------------------------------------------------------------
   1. SCHEMA + PRIVILEGES
   Schema-only account: no one can log in, no password to expire.
   --------------------------------------------------------------------------- */
CREATE USER dbamon NO AUTHENTICATION
  DEFAULT TABLESPACE &app_tbs
  QUOTA 200M ON &app_tbs;

GRANT CREATE TABLE, CREATE PROCEDURE, CREATE JOB TO dbamon;

-- RDS: SYS object grants must go through rdsadmin (direct grants are
-- required because PL/SQL ignores privileges received through roles)
BEGIN
  rdsadmin.rdsadmin_util.grant_sys_object('DBA_USERS', 'DBAMON', 'SELECT');
  rdsadmin.rdsadmin_util.grant_sys_object('UTL_SMTP',  'DBAMON', 'EXECUTE');
  rdsadmin.rdsadmin_util.grant_sys_object('UTL_TCP',   'DBAMON', 'EXECUTE');
END;
/

/* ---------------------------------------------------------------------------
   2. NETWORK ACL  -- DBAMON may connect to the SMTP relay only
   --------------------------------------------------------------------------- */
BEGIN
  DBMS_NETWORK_ACL_ADMIN.APPEND_HOST_ACE(
    host       => '&smtp_host',
    lower_port => &smtp_port,
    upper_port => &smtp_port,
    ace        => xs$ace_type(
                    privilege_list => xs$name_list('connect','resolve','smtp'),
                    principal_name => 'DBAMON',
                    principal_type => xs_acl.ptype_db));
END;
/

ALTER SESSION SET CURRENT_SCHEMA = DBAMON;

/* ---------------------------------------------------------------------------
   3. TABLES
   --------------------------------------------------------------------------- */

-- Password profiles to monitor
CREATE TABLE pwd_notify_profiles (
  profile  VARCHAR2(128) PRIMARY KEY
);

-- Username -> email. DBA_USERS has no email column.
--   HUMAN   = person, emailed directly about their own account
--   SERVICE = app/shared account, reported to the DBA team only
CREATE TABLE pwd_notify_contacts (
  username      VARCHAR2(128) PRIMARY KEY,
  full_name     VARCHAR2(200),
  email         VARCHAR2(320),
  account_type  VARCHAR2(10) DEFAULT 'HUMAN' NOT NULL
                CHECK (account_type IN ('HUMAN','SERVICE')),
  notify        CHAR(1) DEFAULT 'Y' NOT NULL
                CHECK (notify IN ('Y','N')),
  updated_at    DATE DEFAULT SYSDATE
);

-- Every notification sent or failed (audit evidence)
CREATE TABLE pwd_notify_log (
  log_id          NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  username        VARCHAR2(128) NOT NULL,
  expiry_date     DATE          NOT NULL,
  threshold_days  NUMBER        NOT NULL,
  email           VARCHAR2(320),
  status          VARCHAR2(10)  NOT NULL,   -- SENT / FAILED
  error_msg       VARCHAR2(4000),
  sent_at         TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
);

CREATE INDEX pwd_notify_log_ix1
  ON pwd_notify_log (username, expiry_date, threshold_days, status);

