SELECT username, account_status, expiry_date, profile
FROM dba_users
WHERE account_status LIKE '%EXPIRED%';

SELECT DBMS_METADATA.GET_DDL('USER','APP_USER') FROM dual;


ALTER USER app_user IDENTIFIED BY VALUES '<hash from above>' ACCOUNT UNLOCK;

CREATE PROFILE svc_accounts LIMIT PASSWORD_LIFE_TIME UNLIMITED;
ALTER USER app_user PROFILE svc_accounts;


SELECT username, account_status, expiry_date, profile
FROM dba_users
WHERE expiry_date BETWEEN SYSDATE - 7 AND SYSDATE
ORDER BY expiry_date;

SELECT dbusername, userhost, client_program_name,
       return_code, MAX(event_timestamp) AS last_seen, COUNT(*)
FROM unified_audit_trail
WHERE return_code = 28001
  AND event_timestamp > SYSTIMESTAMP - INTERVAL '2' DAY
GROUP BY dbusername, userhost, client_program_name, return_code;
