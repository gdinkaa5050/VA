-- ============================================================
-- Step C: Now pull the REAL ETL_LOG history for the snapshot 
-- steps, using correct column names, and specifically compare 
-- durations/status right around Aug 31 -> Sep 1 (when the 
-- runtime exploded)
-- ============================================================
SELECT batch_id, source_system, subject_area, batch_status,
       start_time, end_time,
       (end_time - start_time) AS duration
FROM ETL.ETL_LOG
WHERE subject_area IN (
        'load_loan_snapshot_pkg.load_loan_snapshots_redefaults',
        'load_loan_snapshot_pkg.load_loan_snapshot',
        'loan_snapshots_wallstreet_pkg.load_loan_snapshots_wallstreet',
        'load data to table loan_borrower_dtl'
     )
  AND start_time >= DATE '2026-08-28'
ORDER BY start_time DESC;
