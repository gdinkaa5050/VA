/

-- Confirm both new jobs exist and are enabled
SELECT job_name, job_action, repeat_interval, enabled
FROM dba_scheduler_jobs
WHERE job_name IN ('DAILY_ETL_EMAIL_JOB', 'MONTHLY_ETL_EMAIL_JOB')
  AND owner = 'ANALYTICS';


STEP 7: Disable the OLD combined job/procedure under ORACLE (don't drop yet)
----------------------------------------------------------------
-- Keep as rollback option for at least one full cycle (through a
-- 1st-of-month run) before dropping anything.

BEGIN
  SYS.DBMS_SCHEDULER.DISABLE('ORACLE.DAILY_ETL_EMAIL_JOB');
END;
/

-- Confirm it's disabled
SELECT job_name, enabled
FROM dba_scheduler_jobs
WHERE job_name = 'DAILY_ETL_EMAIL_JOB'
  AND owner = 'ORACLE';


STEP 8: Post-cutover monitoring
----------------------------------------------------------------
SELECT job_name, owner, log_date, status
FROM dba_scheduler_job_run_details
WHERE job_name IN ('DAILY_ETL_EMAIL_JOB', 'MONTHLY_ETL_EMAIL_JOB')
  AND owner = 'ANALYTICS'
ORDER BY log_date DESC
FETCH FIRST 10 ROWS ONLY;


