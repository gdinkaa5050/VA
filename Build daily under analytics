STEP 5: Test each procedure manually BEFORE creating the scheduled jobs
----------------------------------------------------------------
-- IMPORTANT: before running, temporarily redirect recipients to
-- yourself/your team only - do not run against the full distribution
-- list on the first test of either procedure.

EXEC ANALYTICS.DAILY_ETL_EMAIL;
EXEC ANALYTICS.MONTHLY_ETL_EMAIL;

-- If ORA-24247 (network ACL) - go back to Step 2(d) and confirm
-- ANALYTICS was added to the correct ACL for smtp.va.gov.
-- If ORA-00942/insufficient privileges on dba_scheduler_job_run_details
-- - go back to Step 2(a).

-- Cross-check each email's totals against a fresh query, e.g. for daily:
SELECT COUNT(*) AS row_count, SUM(LENGTH(output)) AS char_count
FROM dba_scheduler_job_run_details
WHERE owner = 'ANALYTICS'
  AND TRUNC(actual_start_date) = TRUNC(SYSDATE);

-- and for monthly:
SELECT COUNT(*) AS row_count, SUM(LENGTH(output)) AS char_count
FROM dba_scheduler_job_run_details
WHERE owner IN ('SRC_VALERIR', 'SRC_WEBLGY')
  AND TRUNC(actual_start_date) = TRUNC(SYSDATE);

-- Compare against "TOTAL JOBS EMAILED" / "TOTAL OUTPUT CHARACTERS"
-- in each respective email.


STEP 6: Create the two scheduler jobs under ANALYTICS
----------------------------------------------------------------
-- DAILY job: runs every day at 16:00 UTC (same time as the original)

BEGIN
  SYS.DBMS_SCHEDULER.CREATE_JOB
  (
      job_name         => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,start_date       => SYSTIMESTAMP
     ,repeat_interval  => 'FREQ=DAILY; BYHOUR=16; BYMINUTE=0; BYSECOND=0;'
     ,end_date         => NULL
     ,job_class        => 'DEFAULT_JOB_CLASS'
     ,job_type         => 'STORED_PROCEDURE'
     ,job_action       => 'DAILY_ETL_EMAIL'
     ,comments         => 'Daily email notification for ANALYTICS job status'
  );

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'RESTARTABLE'
     ,value     => FALSE);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'LOGGING_LEVEL'
     ,value     => SYS.DBMS_SCHEDULER.LOGGING_OFF);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE_NULL
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'MAX_FAILURES');

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE_NULL
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'MAX_RUNS');

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'STOP_ON_WINDOW_CLOSE'
     ,value     => FALSE);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'JOB_PRIORITY'
     ,value     => 3);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE_NULL
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'SCHEDULE_LIMIT');

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'AUTO_DROP'
     ,value     => TRUE);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'RESTART_ON_RECOVERY'
     ,value     => FALSE);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'RESTART_ON_FAILURE'
     ,value     => FALSE);

  SYS.DBMS_SCHEDULER.SET_ATTRIBUTE
    ( name      => 'ANALYTICS.DAILY_ETL_EMAIL_JOB'
     ,attribute => 'STORE_OUTPUT'
     ,value     => TRUE);

  SYS.DBMS_SCHEDULER.ENABLE
    ( name => 'ANALYTICS.DAILY_ETL_EMAIL_JOB');
END;
/

