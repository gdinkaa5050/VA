SELECT u.usename,
       current_database() AS database_name,
       (SELECT COUNT(*) FROM pg_class     c WHERE c.relowner = u.usesysid) AS relations_owned,
       (SELECT COUNT(*) FROM pg_namespace n WHERE n.nspowner = u.usesysid) AS schemas_owned,
       (SELECT COUNT(*) FROM pg_proc      p WHERE p.proowner = u.usesysid) AS functions_owned,
       (SELECT COUNT(*) FROM pg_database  d WHERE d.datdba   = u.usesysid) AS databases_owned,
       CASE WHEN u.usesysid IN (SELECT relowner FROM pg_class)
              OR u.usesysid IN (SELECT nspowner FROM pg_namespace)
              OR u.usesysid IN (SELECT proowner FROM pg_proc)
              OR u.usesysid IN (SELECT datdba   FROM pg_database)
