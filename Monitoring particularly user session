/* ---------------------------------------------------------------------
   4. LOGIN TRACKING: record every logon (run once to set up)
   --------------------------------------------------------------------- */
CREATE AUDIT POLICY track_analytics_logon ACTIONS LOGON;
AUDIT POLICY track_analytics_logon BY aws_analytics_read;

-- Check logins anytime:
SELECT event_timestamp, os_username, userhost, client_program_name
  FROM unified_audit_trail
 WHERE dbusername = 'AWS_ANALYTICS_READ'
 ORDER BY event_timestamp DESC;

