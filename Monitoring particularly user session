/* ---------------------------------------------------------------------
   5. HISTORY: past runs from AWR/ASH (Diagnostics Pack required)
      Alternative with no license: RDS console > Performance Insights,
      slice by "Users".
   --------------------------------------------------------------------- */
SELECT TRUNC(h.sample_time, 'HH24') AS hour,
       h.sql_id, h.machine, h.program,
       COUNT(*) * 10                AS approx_active_secs
  FROM dba_hist_active_sess_history h
 WHERE h.user_id = (SELECT user_id FROM dba_users
                     WHERE username = 'AWS_ANALYTICS_READ')
   AND h.sample_time > SYSDATE - 7
 GROUP BY TRUNC(h.sample_time, 'HH24'), h.sql_id, h.machine, h.program
 ORDER BY hour DESC;


/* ---------------------------------------------------------------------
   6. FIX PREP: existing indexes and partitioning on MESSAGE_QUEUE
      Are CREATED_DATE / STATUS_DATE indexed?
   --------------------------------------------------------------------- */
SELECT i.index_name, i.partitioned, c.column_name, c.column_position
  FROM dba_indexes i
  JOIN dba_ind_columns c
    ON c.index_owner = i.owner AND c.index_name = i.index_name
 WHERE i.table_owner = 'INTG'
   AND i.table_name  = 'MESSAGE_QUEUE'
 ORDER BY i.index_name, c.column_position;

SELECT partitioning_type, column_name
  FROM dba_part_tables t
  JOIN dba_part_key_columns k
    ON k.owner = t.owner AND k.name = t.table_name
 WHERE t.owner = 'INTG' AND t.table_name = 'MESSAGE_QUEUE';

