/* =====================================================================
   Monitoring kit: AWS_ANALYTICS_READ (Mule job) on Valeri Prod
   Target:  INTG.MESSAGE_QUEUE full scans (7 sessions, hash/MOD split)
   Engine:  Oracle on Amazon RDS

   Licensing note:
     Sections 1-4 and 6 use V$ views and unified auditing (no pack needed).
     Section 5 (DBA_HIST_*) requires the Oracle Diagnostics Pack.
   ===================================================================== */


/* ---------------------------------------------------------------------
   1. LIVE: who is connected and what are they running
      MACHINE / PROGRAM / MODULE identify the Mule host and job.
   --------------------------------------------------------------------- */
SELECT sid, serial#, status, machine, program, module,
       sql_id, event, last_call_et AS secs_in_call,
       logon_time
  FROM v$session
 WHERE username = 'AWS_ANALYTICS_READ'
 ORDER BY logon_time;


/* ---------------------------------------------------------------------
   2. LIVE: progress of the full table scans
   --------------------------------------------------------------------- */
SELECT sid, opname, target, sofar, totalwork,
       ROUND(sofar / NULLIF(totalwork, 0) * 100, 1) AS pct_done,
       time_remaining AS secs_remaining
  FROM v$session_longops
 WHERE username = 'AWS_ANALYTICS_READ'
   AND sofar < totalwork;


/* ---------------------------------------------------------------------
   3. BASELINE: cost per execution of their SQL
      Save this output as the "before" numbers.
   --------------------------------------------------------------------- */
SELECT sql_id, executions,
       ROUND(elapsed_time / 1e6 / NULLIF(executions, 0))  AS secs_per_exec,
       ROUND(physical_read_bytes / POWER(1024, 3), 1)      AS gb_read_total,
       buffer_gets,
       SUBSTR(sql_text, 1, 100)                            AS sql_text_start
  FROM v$sqlstats
 WHERE sql_id IN (SELECT sql_id FROM v$session
                   WHERE username = 'AWS_ANALYTICS_READ'
                     AND sql_id IS NOT NULL)
    OR UPPER(sql_text) LIKE '%MESSAGE_QUEUE%STANDARD_HASH%';

